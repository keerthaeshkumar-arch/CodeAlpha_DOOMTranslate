# DOOM Translate - Environment Configuration Example
# Copy this file to .env to configure local environment variables if needed.

# Application Settings
APP_NAME="DOOM Translate"
APP_ENV="development"
PORT=8501

# Optional Translation Service Settings (Optional Custom Proxy / Endpoint)
# HTTP_PROXY=""
# HTTPS_PROXY=""

# Streamlit Server Settings
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_CORS=false
